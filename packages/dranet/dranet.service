[Unit]
Description=DRANET DRA driver for network devices
After=containerd.service kubelet.service
Wants=kubelet.service
# Opt-in: the marker is non-empty only when
# settings.kubelet-dra-drivers.net.enabled is true.
ConditionFileNotEmpty=/etc/dranet/enabled

[Service]
# A brief sleep is needed to avoid the `test` failing its first check.
ExecStartPre=/usr/bin/sleep 0.1
ExecStartPre=/usr/bin/test -d /var/lib/kubelet/plugins_registry
# Fallback for a node with no settings extension. The settings drop-in overrides
# ExecStart with the node name, the bind address, and the device filter.
ExecStart=/usr/bin/dranet \
    --hostname-override %H \
    --kubeconfig /etc/kubernetes/kubelet/kubeconfig \
    --bind-address 127.0.0.1:9177 \
    --v 2
Type=simple
TimeoutSec=0
RestartSec=2
Restart=always
StandardError=journal+console

[Install]
WantedBy=multi-user.target
