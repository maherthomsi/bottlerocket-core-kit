[Unit]
Description=NVIDIA DRA driver GPU kubelet plugin
After=kubelet.service
Wants=kubelet.service
# The DRA driver and the kubernetes device plugin both allocate the same GPUs;
# starting this unit stops the device plugin so the two never run together.
Conflicts=nvidia-k8s-device-plugin.service

[Service]
# A brief sleep is needed to avoid the `test` failing its first check.
ExecStartPre=/usr/bin/sleep 0.1
ExecStartPre=/usr/bin/test -d /var/lib/kubelet/plugins_registry
# --node-name defaults to the host name here; the settings drop-in overrides it
# with settings.kubernetes.hostname-override (the name the kubelet registers).
# --image-name is only used to render MPS control-daemon pods; MPS is alpha and
# disabled by default, and an empty string satisfies the required flag.
# --healthcheck-port -1 disables the gRPC healthcheck: any negative value
# short-circuits startHealthcheck before it creates a listener.
ExecStart=/usr/bin/gpu-kubelet-plugin \
    --node-name %H \
    --namespace kube-system \
    --nvidia-driver-root / \
    --container-driver-root / \
    --cdi-root /etc/cdi \
    --nvidia-cdi-hook-path /usr/bin/nvidia-cdi-hook \
    --kubeconfig /etc/kubernetes/kubelet/kubeconfig \
    --image-name "" \
    --healthcheck-port -1
Type=simple
TimeoutSec=0
RestartSec=2
Restart=always
StandardError=journal+console

[Install]
WantedBy=multi-user.target
